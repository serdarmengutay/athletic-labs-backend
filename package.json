{
  "name": "athletic-labs-backend",
  "version": "1.0.0",
  "description": "Athletic Labs Backend API",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "seed": "npx sequelize-cli db:seed:all",
    "seed:undo": "npx sequelize-cli db:seed:undo:all",
    "sync-db": "npx ts-node src/scripts/sync-database.ts",
    "sync-schema": "npx ts-node src/scripts/sync-schema.ts",
    "add-athlete-test-status": "npx ts-node src/scripts/add-athlete-test-status.ts",
    "create-stations": "npx ts-node src/scripts/create-stations.ts",
    "backfill-gender": "npx ts-node src/scripts/backfill-gender.ts",
    "import-test-folder": "npx ts-node src/scripts/import-test-folder.ts"
  },
  "keywords": [
    "athletic",
    "labs",
    "api",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^13.6.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.3",
    "sequelize": "^6.35.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.8.6",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.7",
    "nodemon": "^3.0.1",
    "sequelize-cli": "^6.6.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
